{
  // Fees come from _broker.jsonc
  "cash": 150, // optional: uninvested cash, in the portfolio's currency
  "securities": [
    {
      "tick": "ETEL",
      "exchange": "EGX",
      "shares": 32,
      "targetPercentage": 0.8
    },
    {
      // Beltone Meya Meya, a mutual fund tracking the EGX100. It isn't exchange-traded: its daily
      // NAV comes from its snduk.com page (here overridden, so the example runs offline)
      "tick": "BMM",
      "exchange": "EGX",
      "snduk": "beltone-meya-100",
      "shares": 150,
      "targetPercentage": 0.2,
      // Optional: this security's own fees. Each part set here replaces the portfolio's and the
      // broker's for this security's orders; the others fall back.
      "minimumTradingFeeFlat": 5
    }
  ]
}
