{
  "name": "stock-calc",
  "version": "1.0.0",
  "description": "Portfolio share calculator: a CLI and an MCP server",
  "type": "module",
  "main": "src/CliApp/app.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cli": "tsx src/CliApp/app.ts",
    "cli:show": "tsx src/CliApp/app.ts show",
    "cli:minimal": "tsx src/CliApp/app.ts minimal",
    "cli:target": "tsx src/CliApp/app.ts target",
    "cli:invest": "tsx src/CliApp/app.ts invest",
    "cli:rebalance": "tsx src/CliApp/app.ts rebalance",
    "mcp": "tsx src/McpApp/app.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^6.0.1",
    "class-validator": "^0.15.1",
    "commander": "^15.0.0",
    "decimal.js": "^10.6.0",
    "jsonc-parser": "^3.3.1",
    "puppeteer": "^25.12.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "bin": {
    "stock-calc-mcp": "bin/stock-calc-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armaaar/stock-calc.git"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    "!src/**/__tests__",
    "!src/__fixtures__",
    "!src/**/CLAUDE.md",
    "!src/data/_*.jsonc"
  ]
}
